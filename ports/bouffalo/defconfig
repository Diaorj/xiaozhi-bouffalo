# FreeRTOS and the verified FHOST Wi-Fi stack for BL616CL.
CONFIG_FREERTOS=y
CONFIG_TLSF=y
CONFIG_LWIP=y
# FHOST net_al_ext.c includes the SDK DHCP server adapter unconditionally.
CONFIG_DHCPD=y
CONFIG_RF=y
CONFIG_WIFI6=y
CONFIG_MACSW_SELECT=default
CONFIG_FHOST=y
CONFIG_WL80211=n
# WPA supplicant uses the SDK crypto component even before HTTPS is added.
CONFIG_MBEDTLS=y
# Use the SDK pthread backend for the original std::mutex.
CONFIG_POSIX=y
CONFIG_SHELL=n
CONFIG_LOG_NCOLOR=y

# SDK HTTP client and full TLS certificate validity checks.
CONFIG_HTTP=y
CONFIG_HTTP_CLIENT=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y

# UUIDv5 device identifier; no cryptographic authentication is based on SHA-1.
CONFIG_MBEDTLS_SHA1=y

# SDK persistent configuration in the existing PSM partition.
CONFIG_LITTLEFS=y
CONFIG_BFLB_MTD=y
CONFIG_PARTITION=y

# Verified board: 4 MiB PSRAM, used for PCM buffering, never directly by DMA.
CONFIG_PSRAM=y
CONFIG_PSRAM_LENGTH=0x400000
CONFIG_BSP_AUDIO_CODEC=y
CONFIG_MULTIMEDIA=y
CONFIG_OPUS=y
